(# Define activity for setting up RTL scan insertion.)Tj
0 -1 TD
(set A [create_custom_activity \\)Tj
T*
(    -name ScanInsertion \\)Tj
T*
(    -type Global \\)Tj
T*
(    -label "Add scan chain to core." \\)Tj
T*
(    -pre "verifyReadyForChain" \\)Tj
T*
(    -post "addScanChain" \\)Tj
T*
(    -description "Activity for adding scan chains" \\)Tj
T*
