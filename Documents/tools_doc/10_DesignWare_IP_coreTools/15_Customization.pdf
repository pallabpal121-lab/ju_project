0 -2 TD
(# Indicates the number of scan chains to be inserted.)Tj
0 -1 TD
(set P [create_custom_activity_parameter \\)Tj
T*
(    -activity $A \\)Tj
T*
(    -name NumberOfChains \\)Tj
T*
(    -type integer \\)Tj
T*
(    -label "Number of Scan Chains" \\)Tj
T*
(    -description \\)Tj
T*
(        {Specify the desired number of scan chains to)Tj
T*
(be inserted.} \\)Tj
T*
(    -default 2])Tj
0 -2 TD
(# Indicates the insertion mode to be used.)Tj
0 -1 TD
(set P [create_custom_activity_parameter \\)Tj
T*
(    -activity $A \\)Tj
T*
(    -name InsertionMode \\)Tj
T*
(    -type string \\)Tj
T*
(    -label "Insertion Mode" \\)Tj
T*
(    -description {Defines the scan chain insertion)Tj
T*
(mode.}])Tj
T*
(set_attribute $P -attr EnumValues \\)Tj
T*
(    -value "Basic Advanced")Tj
T*
(set_attribute $P -attr DefaultValue -value "Basic")Tj
0 -2 TD
